# Model endpoint. The endpoint must support an open assistant prefix or bare
# text completions; use the observer's compatibility test before a real run.
AMI_BASE_URL=https://openrouter.ai/api/v1
AMI_API_KEY=replace-me
AMI_MODEL=replace-with-a-model-id
AMI_CONTEXT_TOKENS=131072

# Generation and local observer settings.
AMI_TEMPERATURE=1
AMI_MAX_TOKENS=8192
AMI_PORT=7717
AMI_START_PAUSED=1
AMI_SAY=0

# Optional: force one interval instead of the configured day/night defaults.
# AMI_GAP_SECONDS=120
# AMI_TIME_ZONE=UTC

# Compatibility note: the AMI_ prefix is retained for existing installations.

