{
  "manifest_version": 3,
  "name": "Hermit",
  "version": "0.2.0",
  "permissions": [
    "scripting",
    "alarms"
  ],
  "host_permissions": [
    "http://127.0.0.1:7717/*",
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Hermit",
    "default_popup": "popup.html"
  }
}
